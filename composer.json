{
  "name": "makeitfly/grumphp-drupal",
  "type": "composer-plugin",
  "description": "GrumPHP + tools for Drupal",
  "require": {
    "composer-plugin-api": "^2.0",
    "phpro/grumphp": "^2.0",
    "squizlabs/php_codesniffer": "^3.4",
    "drupal/coder": "^8.3",
    "mglaman/phpstan-drupal": "^1.2"
  },
  "extra": {
    "class": "Makeitfly\\GrumPhpDrupal\\Composer\\Plugins\\MakeitflyGrumPhpConfiguratorPlugin"
  },
  "autoload": {
    "psr-4": {
      "Makeitfly\\GrumPhpDrupal\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpro/grumphp": true
    }
  }
}
